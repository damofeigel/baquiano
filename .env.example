# ==============================================================================
# Agentic Crawling - Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM / vLLM Endpoint Configuration
# ------------------------------------------------------------------------------
# Base URL for the OpenAI-compatible completions API (e.g., local vLLM, Ollama, OpenAI)
VLLM_BASE_URL=http://localhost:8000/v1

# Model identifier served by your endpoint
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Sampling temperature (0.0 for deterministic JSON extraction)
LLM_TEMPERATURE=0.0

# Maximum output tokens per model call. Keep this small: vLLM rejects requests
# where prompt + max_tokens exceeds --max-model-len.
LLM_MAX_TOKENS=4096

# API key for the LLM endpoint (set to your OpenAI key or "not-needed" for local vLLM)
API_KEY=not-needed

# ------------------------------------------------------------------------------
# Portfolio extraction
# ------------------------------------------------------------------------------
# hybrid: parse the portfolio grid without the LLM, then let the agent fill gaps
# deterministic: no LLM at all; agent: LLM agent only
PORTFOLIO_MODE=hybrid

# ------------------------------------------------------------------------------
# Playwright Browser Automation
# ------------------------------------------------------------------------------
# Browser engine to launch: chromium, firefox, or webkit
PLAYWRIGHT_BROWSER_TYPE=chromium

# Run browser in headless mode (true/false)
HEADLESS=true

# Page navigation and load timeout in milliseconds
TIMEOUT=20000

# Wait duration after initial DOM load (in milliseconds) before scraping
WAIT_AFTER_LOAD=1000

# Text truncation thresholds to protect LLM context window
MAX_TEXT_CHARS=18000
MAX_LINKS=120
MAX_HTML_CHARS=12000

# ------------------------------------------------------------------------------
# I/O File Paths
# ------------------------------------------------------------------------------
# Folder (relative to the project root) for results. Each run writes its own
# file, e.g. output/gridexponential.com_20261010-013619.json
OUTPUT_DIR=output

# Optional pages cache/index file
PAGES_FILE=pages.json

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

